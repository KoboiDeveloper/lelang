# Express API (lelang-be)
NEXT_PUBLIC_API_URL=http://localhost:4100

# Email via Brevo (opsional — dipakai jika FE masih kirim email lokal)
# Daftar: https://app.brevo.com
BREVO_API_KEY=xkeysib-your_api_key_here
BREVO_FROM_EMAIL=noreply@amscorp.co.id
BREVO_FROM_NAME=E-Lelang

# SMTP fallback (opsional)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email@example.com
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM=noreply@amscorp.co.id
SMTP_FROM_NAME=E-Lelang

# API cek NIK karyawan (registrasi bidder) — prefer via BE /api/employee/by-nik
EMPLOYEE_API_BASE_URL=https://golangapi-j5iu.onrender.com
EMPLOYEE_API_KEY=your_employee_api_key_here

# Browser push notifications (barang baru)
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@amscorp.id
PUSH_WEBHOOK_SECRET=your_random_webhook_secret
